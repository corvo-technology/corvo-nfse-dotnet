<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: XML docs are present on public API surface (types, methods, properties);
         generated record scaffolding (positional parameters) is exempted. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Corvo.Nfse</PackageId>
    <Version>0.3.0</Version>
    <Authors>Corvo Technology</Authors>
    <Company>Corvo Technology</Company>
    <Product>Corvo NFS-e SDK</Product>
    <Description>.NET SDK for the Corvo NFS-e API: issue Brazilian service invoices, calculate taxes, verify webhooks. Result-style errors, cursor pagination.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://corvo.tech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/corvo-technology/corvo-nfse-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>corvo;nfse;nfs-e;brazil;invoice;fiscal;e-invoice</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0: API contract 0.3.0 (94 operations). Breaking: new plan slugs, credits without overage, Invoices.CreateAsync returns InvoiceCreateResult (invoice or schedule), webhook test result. Added: customers, CNPJ lookup, service favorites, accountant package, schedules, imports, integrations, substitute, review, overview, DPS sequence, fiscal and service tax profiles, fiscal portal status.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
